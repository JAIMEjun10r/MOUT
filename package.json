{
  "name": "serverest-cypress-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Testes E2E e de API do ServeRest com Cypress e JavaScript.",
  "type": "module",
  "scripts": {
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --e2e --browser chrome",
    "cy:run:front": "cypress run --e2e --browser chrome --spec \"cypress/e2e/frontend/**/*.cy.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "test": "npm run lint && npm run format:check && npm run cy:run:front"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cypress": "16.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-cypress": "7.0.4",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.8"
    },
    "eslint": {
      "minimatch": "11.0.8"
    }
  },
  "allowScripts": {
    "cypress@16.3.0": true
  }
}
